# Reference checkouts: public repositories, clone them when needed.
# `Reference/README.md` explains how to recreate the golden data.
spektrafilm/
SpektraLab/

# Python environments and caches (hundreds of MB, recreate with uv).
.venv/
.uv-cache/
.uv-python/
.mplcache/
__pycache__/
*.pyc

# Build products
build/
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# The Mac hand-off archive is a build artifact of Tools/package-mac.py
dist/
*.zip

# Generated by Reference/export_goldens.py; the copy the package ships lives
# under Swift/Sources/SpektraCore/Resources/goldens and *is* tracked.
Reference/goldens/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# The CI workflow needs the `workflow` OAuth scope to push. Add it back with
# `gh auth refresh -s workflow`, delete this rule, then commit .github/.
.github/
